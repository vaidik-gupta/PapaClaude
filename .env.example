# Deployment configuration template.
# Copy to `.env` and fill in real values for a deployed environment.
# In local dev, `.env.local` is layered on top of this file and overrides it.

ENVIRONMENT=production
LOG_LEVEL=INFO

# Anthropic / Claude Agent SDK
ANTHROPIC_API_KEY=

# Service auth. USER_NAME is the admin account (only it can register users).
# In deployment USER_KEY is supplied by the auth-management service.
USER_NAME=admin
USER_KEY=

# AWS (real endpoints — leave AWS_ENDPOINT_URL empty to use real AWS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
S3_BUCKET=
DYNAMODB_TABLE=

# MongoDB
MONGODB_URI=
MONGODB_DB=papaclaude

# App
APP_HOST=0.0.0.0
APP_PORT=8000
