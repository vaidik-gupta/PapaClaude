# Local development configuration template.
# Copy to `.env.local`. These values point at the docker-compose containers
# and are layered on top of `.env`, overriding it for local development.

ENVIRONMENT=local
LOG_LEVEL=DEEP_DEBUG

# Anthropic / Claude Agent SDK.
# Leave blank to use your Claude subscription via OAuth: run `claude setup-token`
# once (opens a browser). Set a real sk-ant-... key only for Console API billing.
ANTHROPIC_API_KEY=

# Service auth — local admin account (admin/admin for local dev)
USER_NAME=admin
USER_KEY=admin

# AWS via LocalStack (test/test are LocalStack's dummy credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=mymaid-local
DYNAMODB_TABLE=mymaid-local

# MongoDB (docker-compose)
MONGODB_URI=mongodb://root:example@localhost:27017
MONGODB_DB=mymaid

# App
APP_HOST=0.0.0.0
APP_PORT=8000
