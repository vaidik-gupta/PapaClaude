# Local development configuration template.
# Copy to `.env.local`. These values point at the docker-compose containers
# and are layered on top of `.env`, overriding it for local development.

ENVIRONMENT=local
LOG_LEVEL=DEEP_DEBUG

# GitHub Copilot SDK.
# A Copilot-subscription-backed GitHub token (gho_/ghu_/github_pat_). Leave blank
# to use the logged-in GitHub user. COPILOT_MODEL is the model id to run
# (list options with client.list_models()).
GITHUB_TOKEN=
COPILOT_MODEL=claude-sonnet-4.5

# Service auth — local admin account (admin/admin for local dev)
USER_NAME=admin
USER_KEY=admin

# AWS via LocalStack (test/test are LocalStack's dummy credentials)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=papaclaude-local
DYNAMODB_TABLE=papaclaude-local

# MongoDB (docker-compose)
MONGODB_URI=mongodb://root:example@localhost:27017
MONGODB_DB=papaclaude

# App
APP_HOST=0.0.0.0
APP_PORT=8000
